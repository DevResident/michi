<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Provider tokens (access and refresh) never leave the device. Each
         provider has its own prefs file (see tokenPrefsName); list every one
         here, because these rules do not accept wildcards.
         DataExtractionRulesTest fails if a provider file is missing.
         Everything else (notably michi_settings.xml) keeps the default backup
         behavior. -->
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="michi_anilist_auth.xml" />
        <exclude
            domain="sharedpref"
            path="michi_auth_mal.xml" />
        <exclude
            domain="sharedpref"
            path="michi_link_anilist.xml" />
        <exclude
            domain="sharedpref"
            path="michi_link_mal.xml" />
        <!-- The list caches live under cacheDir; never back them up. -->
        <exclude
            domain="root"
            path="cache/michi_cache/" />
        <!-- The durable mirror outbox carries notes/statuses/dates: keep it local too. -->
        <exclude
            domain="file"
            path="michi_durable/" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="michi_anilist_auth.xml" />
        <exclude
            domain="sharedpref"
            path="michi_auth_mal.xml" />
        <exclude
            domain="sharedpref"
            path="michi_link_anilist.xml" />
        <exclude
            domain="sharedpref"
            path="michi_link_mal.xml" />
        <exclude
            domain="root"
            path="cache/michi_cache/" />
        <exclude
            domain="file"
            path="michi_durable/" />
    </device-transfer>
</data-extraction-rules>
